from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from pathlib import Path

from fastapi import FastAPI
from fastapi.staticfiles import StaticFiles
from organizeme_chrome.static_paths import static_mount_path

BASE_DIR = Path(__file__).resolve().parent


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    yield
    # Imported here, not at module level, so importing app.main (e.g. for /health tests that
    # never touch the DB) doesn't force DATABASE_URL/Settings to be resolved at import time.
    from app.db.session import get_engine

    await get_engine().dispose()


app = FastAPI(title="{{APP_TITLE}}", lifespan=lifespan)
# The shared Load Balancer (and the local-dev Caddy proxy) only route this exact prefix to this
# service - see docs/how-to-add-a-hosted-app.md's "Static asset mounting" section. No bare
# `/static` mount needed for a brand-new app.
app.mount(
    static_mount_path("{{APP_SLUG}}"), StaticFiles(directory=BASE_DIR / "static"), name="static"
)

# Register page and API routers here as they're built, e.g.:
#   from app.pages.home import router as home_router
#   app.include_router(home_router)


@app.get("/health")
async def health() -> dict[str, str]:
    return {"status": "ok"}
