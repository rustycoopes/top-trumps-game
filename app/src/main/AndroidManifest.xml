<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- All three below are normal permissions on API 26+ — no runtime prompt. CHANGE_NETWORK_STATE
         also justifies the connectedDevice foreground service type. See the foreground-service ADR. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- AOSP's NsdManager doesn't require a multicast lock, but several OEMs (Samsung among them)
         filter multicast frames on Wi-Fi once the radio's been idle a while regardless — without
         this, discovery flickers or drops mid-session. See the NSD reliability ADR. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Runtime on API 33+, but the service runs whether or not it's granted — denial only hides
         the notification (MatchForegroundService.updateNotification). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TopTrumpsApplication"
        android:allowBackup="true"
        android:label="Top Trumps"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.TopTrumps">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MatchForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
